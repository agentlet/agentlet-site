---
import SceneFrame from './SceneFrame.astro';
---

<SceneFrame
	class="scene-fillform"
	caption="An expense form filling in automatically: vendor, date, amount and cost center, then the submit button gets a highlighted outline for the user to review, not submitted automatically."
>
	<Fragment slot="app">
		<div class="scene-app-url">expenses.internal.app</div>
		<div class="scene-bar" style="width:55%"></div>
		<div class="scene-field">
			<span class="scene-field-value" style="animation-delay:0ms">Northwind Supply Co.</span>
		</div>
		<div class="scene-field">
			<span class="scene-field-value" style="animation-delay:220ms">2024-03-12</span>
		</div>
		<div class="scene-field">
			<span class="scene-field-value" style="animation-delay:440ms">$412.00</span>
		</div>
		<div class="scene-field">
			<span class="scene-field-value" style="animation-delay:660ms">Travel</span>
		</div>
		<div class="scene-submit scene-submit-highlight">Submit</div>
	</Fragment>
	<Fragment slot="panel">
		<div class="scene-panel-brand">
			<img src="/brand/agentlet-symbol-light.svg" alt="" width="16" height="16" />
			<span>agentlet</span>
		</div>
		<div class="scene-action scene-action-primary scene-click-target" style="--cursor-offset-x:14cqi;--cursor-offset-y:12cqi">
			Fill this form
			<span class="scene-cursor"></span>
			<span class="scene-click-pulse"></span>
		</div>
		<div class="scene-action">Extract table</div>
		<div class="scene-action">Analyze page</div>
		<p class="scene-note" style="animation-delay:900ms">Review, then submit</p>
	</Fragment>
</SceneFrame>
