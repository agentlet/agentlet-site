---
import SceneFrame from './SceneFrame.astro';
---

<SceneFrame
	class="scene-shadowdom"
	caption="A host page with aggressive red, uppercase, heavy-border buttons. A pulse shows that styling reaching the dashed shadow root boundary around the panel and stopping there: the panel keeps its own clean style."
	cursorStart={{ x: '50cqi', y: '90cqi' }}
	cursorTarget={{ x: '50cqi', y: '90cqi' }}
>
	<Fragment slot="app">
		<div class="scene-app-url">legacy-crm.internal</div>
		<p class="scene-hostile-heading">Account overview</p>
		<div class="scene-hostile-btn">Save</div>
		<div class="scene-hostile-btn">Delete</div>
		<div class="scene-host-wave"></div>
	</Fragment>
	<Fragment slot="panel">
		<div class="scene-shadow-boundary">
			<span class="scene-shadow-label">shadow root</span>
		</div>
		<div class="scene-panel-brand">
			<img src="/brand/agentlet-symbol-light.svg" alt="" width="16" height="16" />
			<span>agentlet</span>
		</div>
		<div class="scene-action scene-action-primary">Fill this form</div>
		<div class="scene-action">Export table</div>
		<div class="scene-action">Analyze page</div>
	</Fragment>
</SceneFrame>

<style is:global>
	/* This scene has no click to point at: the story is the boundary
	   itself holding, not an interaction, so the fake cursor stays out of
	   the way entirely. */
	.scene-shadowdom .scene-cursor,
	.scene-shadowdom .scene-click-pulse {
		display: none;
	}

	.scene-shadowdom .scene-hostile-heading {
		margin: 0;
		font-size: 2.8cqi;
		font-weight: 800;
		text-transform: uppercase;
		color: #c0392b;
	}

	.scene-shadowdom .scene-hostile-btn {
		align-self: flex-start;
		padding: 1.4cqi 2.6cqi;
		font-size: 2.3cqi;
		font-weight: 800;
		text-transform: uppercase;
		color: #ffffff;
		background: #e74c3c;
		border: 3px solid #922b21;
		border-radius: 2px;
	}

	.scene-shadowdom .scene-panel {
		position: relative;
	}

	.scene-shadowdom .scene-shadow-boundary {
		position: absolute;
		inset: 0.6cqi;
		border: 1.5px dashed var(--color-accent);
		border-radius: 6px;
		pointer-events: none;
	}

	.scene-shadowdom .scene-shadow-label {
		position: absolute;
		top: -1.6cqi;
		left: 1.4cqi;
		padding: 0.2cqi 0.8cqi;
		background: var(--color-surface);
		font-family: var(--font-mono);
		font-size: 2cqi;
		color: var(--color-accent-text);
	}

	/* A glow at the app/panel seam, pulsing as if the host's styles keep
	   pushing against the boundary and never get through. */
	.scene-shadowdom .scene-host-wave {
		position: absolute;
		top: 0;
		bottom: 0;
		right: 0;
		width: 0.6cqi;
		background: #e74c3c;
		opacity: 0;
		animation-name: scene-pulse;
		animation-duration: var(--scene-duration);
		animation-timing-function: ease-in-out;
		animation-iteration-count: infinite;
	}

	@media (prefers-reduced-motion: reduce) {
		.scene-shadowdom .scene-host-wave {
			opacity: 0.7 !important;
		}
	}
</style>
