---
import SceneFrame from './SceneFrame.astro';
---

<SceneFrame
	class="scene-auth"
	caption="The panel asks to sign in, with its actions greyed out. Clicking opens a small identity provider popup, labelled id.example.com, which closes on its own, and then a Signed in pill appears as the actions turn active."
	cursorStart={{ x: '78cqi', y: '80cqi' }}
	cursorTarget={{ x: '82cqi', y: '22cqi' }}
>
	<Fragment slot="app">
		<div class="scene-app-url">portal.internal.app</div>
		<div class="scene-bar" style="width:50%"></div>
		<div class="scene-field"></div>
		<div class="scene-field"></div>
		<div class="scene-popup">
			<div class="scene-popup-bar">id.example.com</div>
			<div class="scene-bar" style="width:70%"></div>
			<div class="scene-field" style="height:5cqi"></div>
			<div class="scene-field" style="height:5cqi"></div>
		</div>
	</Fragment>
	<Fragment slot="panel">
		<div class="scene-panel-brand">
			<img src="/brand/agentlet-symbol-light.svg" alt="" width="16" height="16" />
			<span>agentlet</span>
		</div>
		<div class="scene-action scene-action-primary">Sign in to continue</div>
		<div class="scene-action scene-auth-gated">Fill this form</div>
		<div class="scene-action scene-auth-gated">Export table</div>
		<span class="scene-pill scene-auth-pill" style="animation-delay:3600ms">Signed in</span>
	</Fragment>
</SceneFrame>

<style is:global>
	.scene-auth .scene-popup {
		position: absolute;
		inset: 14% 10%;
		display: flex;
		flex-direction: column;
		gap: 1.4cqi;
		padding: 1.8cqi;
		background: var(--color-bg);
		border: 1px solid var(--color-surface-border);
		border-radius: 8px;
		opacity: 0;
		transform: scale(0.92);
		animation-name: scene-popup;
		animation-timing-function: steps(1, end);
		animation-duration: var(--scene-duration);
		animation-iteration-count: infinite;
	}

	.scene-auth .scene-popup-bar {
		font-family: var(--font-mono);
		font-size: 2.2cqi;
		color: var(--color-text-muted);
	}

	@keyframes scene-popup {
		0%,
		32% {
			opacity: 0;
			transform: scale(0.92);
		}
		38%,
		56% {
			opacity: 1;
			transform: scale(1);
		}
		62%,
		100% {
			opacity: 0;
			transform: scale(0.92);
		}
	}

	/* Gated actions start dim and become fully opaque once signed in. */
	.scene-auth .scene-auth-gated {
		opacity: 0.45;
		animation-name: scene-auth-enable;
		animation-timing-function: steps(1, end);
		animation-duration: var(--scene-duration);
		animation-iteration-count: infinite;
	}

	@keyframes scene-auth-enable {
		0%,
		62% {
			opacity: 0.45;
		}
		70%,
		100% {
			opacity: 1;
		}
	}

	.scene-auth .scene-auth-pill {
		background: var(--color-badge-bg);
		color: var(--color-badge-text);
	}

	@media (prefers-reduced-motion: reduce) {
		.scene-auth .scene-popup {
			opacity: 0 !important;
		}

		.scene-auth .scene-auth-gated {
			opacity: 1 !important;
		}
	}
</style>
