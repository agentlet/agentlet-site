---
import SceneFrame from './SceneFrame.astro';

// A single ~37s, 8-step story of the agentlet principle: one host page
// that only takes manual entry, never changing, gaining an agentlet
// panel (floating on top of it) that reads an uploaded receipt, adds an
// Excel export the app lacks, and answers questions about the page.
// Step 7 calls out the host page and the agentlet layer; step 8 shows
// example features from the library on top of the whole scene.
//
// Unlike the other scenes (one continuous CSS keyframe timeline keyed to
// --scene-duration), this one is driven step by step: src/scripts/
// scenes.ts sets data-step="1".."8" on the .scene root on a timer (or
// when a progress segment is clicked), and every rule below keys off
// that attribute. Anything that must happen at a given moment inside a
// step is either a transition-delay scoped to that step only, or a
// step-scoped keyframe animation. Scoping the delays to their own step
// keeps a direct jump to a later step instant: the end state of earlier
// steps applies with no delay. Keyframe durations here (in the "step N
// dwell" comments) must match the durations Hero.astro hands to the
// controller.
---

<SceneFrame
	class="scene-herostory"
	caption="An animated walkthrough: an expense report page that only takes manual entry gains an agentlet panel on top of it. The panel reads an uploaded receipt into the form, adds an Excel export the app does not have, and answers questions about the page, all without changing the host page itself. It ends with example features from the agentlet library."
	aspectRatio="4 / 3"
	chrome
>
	<Fragment slot="chrome">
		<span class="story-chrome-url">expenses.internal.app/report/2291</span>
		<span class="story-ext-icon scene-click-target" style="--cursor-offset-x:1cqi;--cursor-offset-y:13cqi">
			<img class="story-ext-symbol" src="/brand/agentlet-symbol-light.svg" alt="" width="16" height="16" />
			<span class="story-ext-badge"></span>
			<span class="story-ext-tooltip">agentlet for expenses</span>
			<span class="scene-cursor story-cursor story-cursor-step2"></span>
			<span class="scene-click-pulse story-pulse story-pulse-step2"></span>
		</span>
	</Fragment>
	<Fragment slot="app">
		<div class="story-app-head">
			<span class="story-app-title">Expense report</span>
			<span class="story-manual-pill">Manual entry only</span>
		</div>
		<div class="story-app-main">
			<div class="story-app-form">
				<div class="story-field-grid">
					<div
						class="story-field-group story-field-group-vendor scene-click-target"
						style="--cursor-offset-x:10cqi;--cursor-offset-y:8cqi"
					>
						<span class="story-field-label">Vendor</span>
						<div class="scene-field story-field-vendor-box">
							<span class="story-typing"><span class="story-typing-text">Ced</span><span class="story-caret"></span></span>
							<span class="scene-field-value story-field-value story-field-vendor">Cedar &amp; Co</span>
						</div>
						<span class="scene-cursor story-cursor story-cursor-step1"></span>
						<span class="scene-click-pulse story-pulse story-pulse-step1"></span>
					</div>
					<div class="story-field-group">
						<span class="story-field-label">Date</span>
						<div class="scene-field">
							<span class="scene-field-value story-field-value story-field-date">2024-03-21</span>
						</div>
					</div>
					<div class="story-field-group">
						<span class="story-field-label">Amount</span>
						<div class="scene-field">
							<span class="scene-field-value story-field-value story-field-amount">$187.40</span>
						</div>
					</div>
					<div class="story-field-group">
						<span class="story-field-label">Category</span>
						<div class="scene-field">
							<span class="scene-field-value story-field-value story-field-category">Travel</span>
						</div>
					</div>
				</div>
				<div class="scene-submit scene-submit-highlight story-submit">Submit</div>
				<div class="story-table">
					<div class="story-row story-row-head">
						<span>Line item</span><span>Amount</span>
					</div>
					<div class="story-row">
						<span>Hotel</span><span>$420.00</span>
					</div>
					<div class="story-row">
						<span>Meals</span><span>$96.50</span>
					</div>
					<div class="story-row">
						<span>Taxi</span><span>$54.20</span>
					</div>
				</div>
			</div>
			<div class="story-app-side">
				<span class="story-field-label">Recent reports</span>
				<div class="story-side-item"><span class="scene-bar"></span><span class="scene-bar"></span></div>
				<div class="story-side-item"><span class="scene-bar"></span><span class="scene-bar"></span></div>
				<div class="story-side-item"><span class="scene-bar"></span><span class="scene-bar"></span></div>
			</div>
		</div>
		<span class="story-app-label">your app, unchanged</span>
	</Fragment>
	<Fragment slot="panel">
		<span class="story-agentlet-layer-label">agentlet layer</span>
		<div class="scene-panel-brand">
			<img src="/brand/agentlet-symbol-light.svg" alt="" width="16" height="16" />
			<span>agentlet</span>
		</div>
		<div
			class="scene-action story-action story-action-receipt scene-click-target"
			style="--cursor-offset-x:14cqi;--cursor-offset-y:10cqi"
		>
			Read a receipt
			<span class="scene-cursor story-cursor story-cursor-step4"></span>
			<span class="scene-click-pulse story-pulse story-pulse-step4"></span>
		</div>
		<div
			class="scene-action story-action story-action-export scene-click-target"
			style="--cursor-offset-x:14cqi;--cursor-offset-y:10cqi"
		>
			Export to Excel
			<span class="scene-cursor story-cursor story-cursor-step5"></span>
			<span class="scene-click-pulse story-pulse story-pulse-step5"></span>
		</div>
		<div
			class="scene-action story-action story-action-ai scene-click-target"
			style="--cursor-offset-x:14cqi;--cursor-offset-y:10cqi"
		>
			Ask about this page
			<span class="scene-cursor story-cursor story-cursor-step6"></span>
			<span class="scene-click-pulse story-pulse story-pulse-step6"></span>
		</div>
		<div class="story-result">
			<span class="scene-chip story-receipt-chip">Receipt read</span>
			<div class="story-xlsx-block">
				<span class="scene-chip story-xlsx-chip">expenses.xlsx, 3 rows</span>
				<p class="story-xlsx-note">Not in the app. Added by the agentlet.</p>
			</div>
			<div class="story-ai-block">
				<p class="story-bubble story-bubble-question">Anything unusual here?</p>
				<p class="story-bubble story-bubble-answer story-ai-answer-1">The hotel is 40% above policy.</p>
				<p class="story-bubble story-bubble-answer story-ai-answer-2">Everything else is in range.</p>
			</div>
		</div>
	</Fragment>
	<Fragment slot="overlay">
		<div class="story-modal-backdrop">
			<div class="story-modal">
				<p class="story-modal-title">Read a receipt</p>
				<div class="story-dropzone">
					<span>Drop a receipt here</span>
					<span class="story-dropzone-hint">PDF or image</span>
				</div>
				<div class="story-file">
					<span class="story-file-name">receipt.pdf</span>
					<span class="story-file-track"><span class="story-file-bar"></span></span>
				</div>
			</div>
		</div>
		<div class="story-features">
			<p class="story-features-heading">Ready to use in the library</p>
			<div class="story-features-grid">
				<span class="story-feature" style="--i:0">Read PDFs and images with AI</span>
				<span class="story-feature" style="--i:1">Fill forms</span>
				<span class="story-feature" style="--i:2">Export tables to Excel</span>
				<span class="story-feature" style="--i:3">Screenshots for visual analysis</span>
				<span class="story-feature" style="--i:4">Dialogs and progress</span>
				<span class="story-feature" style="--i:5">Sign in with your identity provider</span>
			</div>
			<p class="story-features-heading story-features-heading-ideas">Or build your own</p>
			<div class="story-features-grid">
				<span class="story-feature story-feature-idea" style="--i:7">Check against a policy</span>
				<span class="story-feature story-feature-idea" style="--i:8">Bulk entry from a spreadsheet</span>
				<span class="story-feature story-feature-idea" style="--i:9">Your idea here</span>
			</div>
		</div>
	</Fragment>
</SceneFrame>

<style is:global>
	.scene-herostory .story-chrome-url {
		flex: 1;
	}

	/* --- Layout: unlike the other scenes' side-by-side grid, the host app
	   here takes the full width, and the agentlet panel floats on top of
	   it (covering the app's own "recent reports" column), to show that
	   the agentlet is an overlay, not part of the page. --- */
	.scene-herostory .scene-body {
		display: block;
	}

	.scene-herostory .scene-app {
		position: absolute;
		inset: 0;
		padding: 3cqi;
		gap: 1.3cqi;
		opacity: 1;
		transition: opacity 0.4s ease;
	}

	.scene-herostory .story-app-head {
		display: flex;
		align-items: center;
		gap: 2cqi;
	}

	.scene-herostory .story-app-title {
		font-size: 2.8cqi;
		font-weight: 600;
		color: var(--color-heading);
	}

	/* Step 1 insists on the app as it is: manual entry only. */
	.scene-herostory .story-manual-pill {
		font-family: var(--font-mono);
		font-size: 1.9cqi;
		padding: 0.5cqi 1.4cqi;
		border-radius: 999px;
		border: 1px solid var(--color-accent);
		color: var(--color-accent-text);
		opacity: 0;
		transition: opacity 0.4s ease;
	}

	.scene-herostory[data-step='1'] .story-manual-pill {
		opacity: 1;
		transition-delay: 1.4s;
	}

	.scene-herostory .story-app-main {
		display: grid;
		grid-template-columns: 56cqi minmax(0, 1fr);
		gap: 4cqi;
	}

	.scene-herostory .story-app-form {
		display: flex;
		flex-direction: column;
		gap: 1.3cqi;
	}

	.scene-herostory .story-app-side {
		display: flex;
		flex-direction: column;
		gap: 1.2cqi;
	}

	.scene-herostory .story-side-item {
		display: flex;
		flex-direction: column;
		gap: 0.8cqi;
		padding: 1.4cqi;
		border: 1px solid var(--color-surface-border);
		border-radius: 6px;
	}

	.scene-herostory .story-side-item .scene-bar {
		height: 1.6cqi;
	}

	.scene-herostory .story-side-item .scene-bar + .scene-bar {
		width: 60%;
	}

	/* Step 7 holds the finished state and calls out the two layers: the
	   host page, dimmed and labelled, and the agentlet panel, outlined
	   and labelled (see the panel rules further down). */
	.scene-herostory[data-step='7'] .scene-app {
		opacity: 0.55;
	}

	.scene-herostory .story-app-label {
		align-self: flex-start;
		margin-top: auto;
		font-family: var(--font-mono);
		font-size: 1.9cqi;
		color: var(--color-text-muted);
		opacity: 0;
		transition: opacity 0.4s ease;
	}

	.scene-herostory[data-step='7'] .story-app-label {
		opacity: 1;
		transition-delay: 0.2s;
	}

	.scene-herostory .scene-field {
		height: 5.5cqi;
		transition: border-color 0.3s ease;
	}

	/* --- Step 1: the user types into the form by hand. --- */
	.scene-herostory .story-field-group-vendor {
		position: relative;
	}

	.scene-herostory[data-step='1'] .story-field-vendor-box {
		border-color: var(--color-accent);
		transition-delay: 0.7s;
	}

	.scene-herostory .story-typing {
		position: absolute;
		inset: 0;
		display: flex;
		align-items: center;
		padding-inline: 1.6cqi;
		font-size: 2.6cqi;
		color: var(--color-heading);
		opacity: 0;
	}

	.scene-herostory[data-step='1'] .story-typing {
		opacity: 1;
	}

	.scene-herostory .story-typing-text {
		clip-path: inset(0 100% 0 0);
	}

	/* Step 1 dwell is 4000ms: three letters typed slowly from 1s on. */
	.scene-herostory[data-step='1'] .story-typing-text {
		animation: story-typing 4000ms steps(1, end) forwards;
	}

	@keyframes story-typing {
		0%,
		25% {
			clip-path: inset(0 100% 0 0);
		}
		40% {
			clip-path: inset(0 66% 0 0);
		}
		55% {
			clip-path: inset(0 33% 0 0);
		}
		70%,
		100% {
			clip-path: inset(0 0 0 0);
		}
	}

	.scene-herostory .story-caret {
		display: inline-block;
		width: 0.25cqi;
		height: 3cqi;
		margin-left: 0.2cqi;
		background: var(--color-heading);
	}

	.scene-herostory[data-step='1'] .story-caret {
		animation: story-caret-blink 900ms steps(1, end) infinite;
	}

	@keyframes story-caret-blink {
		50% {
			opacity: 0;
		}
	}

	/* --- Browser chrome: the agentlet extension icon. --- */
	.scene-herostory .story-ext-icon {
		position: relative;
		display: grid;
		place-items: center;
		width: 5.4cqi;
		height: 5.4cqi;
		border-radius: 4px;
		background: var(--color-surface-border);
	}

	.scene-herostory .story-ext-symbol {
		width: 72%;
		height: 72%;
	}

	.scene-herostory .story-ext-badge {
		position: absolute;
		top: -0.6cqi;
		right: -0.6cqi;
		width: 2cqi;
		height: 2cqi;
		border-radius: 999px;
		background: var(--color-accent);
		border: 0.4cqi solid var(--color-surface);
		opacity: 0;
		transition: opacity 0.4s ease;
	}

	.scene-herostory:not([data-step='1']) .story-ext-badge {
		opacity: 1;
	}

	/* Step 2: the icon announces the agentlet, then gets clicked. */
	.scene-herostory[data-step='2'] .story-ext-icon {
		animation: story-ext-ring 1200ms ease-out 2;
	}

	@keyframes story-ext-ring {
		0% {
			box-shadow: 0 0 0 0 var(--color-accent);
		}
		100% {
			box-shadow: 0 0 0 1.6cqi transparent;
		}
	}

	.scene-herostory .story-ext-tooltip {
		position: absolute;
		top: calc(100% + 1.6cqi);
		right: 0;
		z-index: 20;
		padding: 0.8cqi 1.4cqi;
		border-radius: 6px;
		background: var(--color-primary-bg);
		color: var(--color-primary-text);
		font-family: var(--font-mono);
		font-size: 2cqi;
		white-space: nowrap;
		opacity: 0;
		transform: translateY(-1cqi);
		transition:
			opacity 0.3s ease,
			transform 0.3s ease;
		pointer-events: none;
	}

	.scene-herostory[data-step='2'] .story-ext-tooltip {
		opacity: 1;
		transform: translateY(0);
		transition-delay: 0.3s;
	}

	/* --- Cursor and click pulse: this scene keys them off data-step
	   instead of the shared percentage timeline in scenes.css. Each step
	   sets when its cursor arrives (--cursor-at) and the pulse fires
	   0.5s later. --- */
	.scene-herostory .story-cursor,
	.scene-herostory .story-pulse {
		--cursor-at: 0.2s;

		animation: none;
	}

	.scene-herostory .story-cursor-step2,
	.scene-herostory .story-pulse-step2 {
		--cursor-at: 1.6s;
	}

	.scene-herostory .story-cursor {
		opacity: 0;
		transition:
			opacity 0.35s ease,
			transform 0.45s ease;
	}

	.scene-herostory .story-pulse {
		opacity: 0;
	}

	.scene-herostory[data-step='1'] .story-cursor-step1,
	.scene-herostory[data-step='2'] .story-cursor-step2,
	.scene-herostory[data-step='4'] .story-cursor-step4,
	.scene-herostory[data-step='5'] .story-cursor-step5,
	.scene-herostory[data-step='6'] .story-cursor-step6 {
		opacity: 1;
		transform: translate(0, 0);
		transition-delay: var(--cursor-at);
	}

	.scene-herostory[data-step='1'] .story-pulse-step1,
	.scene-herostory[data-step='2'] .story-pulse-step2,
	.scene-herostory[data-step='4'] .story-pulse-step4,
	.scene-herostory[data-step='5'] .story-pulse-step5,
	.scene-herostory[data-step='6'] .story-pulse-step6 {
		/* One-shot pulse: fires once whenever this step's attribute value
		   freshly matches, including on every loop replay. */
		animation: story-click-pulse 800ms ease-out calc(var(--cursor-at) + 0.5s) backwards;
	}

	@keyframes story-click-pulse {
		0% {
			opacity: 0;
			transform: scale(0.3);
		}
		30% {
			opacity: 0.6;
			transform: scale(0.5);
		}
		100% {
			opacity: 0;
			transform: scale(1.6);
		}
	}

	/* --- The panel: hidden for steps 1-2, floating on top of the app
	   from step 3. --- */
	.scene-herostory .scene-panel {
		position: absolute;
		top: 2cqi;
		right: 2cqi;
		bottom: 2cqi;
		width: 36cqi;
		gap: 1.1cqi;
		border: 1px solid var(--color-surface-border);
		border-radius: 8px;
		box-shadow: 0 1.2cqi 4cqi rgb(0 0 0 / 0.18);
		opacity: 0;
		transform: translateX(6cqi);
		transition:
			opacity 0.5s ease,
			transform 0.5s ease,
			outline-color 0.4s ease;
		outline: 1.5px dashed transparent;
		outline-offset: 0.6cqi;
	}

	.scene-herostory:not([data-step='1'], [data-step='2']) .scene-panel {
		opacity: 1;
		transform: translateX(0);
	}

	/* Step 7: a dashed outline traces the agentlet layer. */
	.scene-herostory[data-step='7'] .scene-panel {
		outline-color: var(--color-accent);
	}

	.scene-herostory .story-agentlet-layer-label {
		position: absolute;
		bottom: 0.8cqi;
		right: 0.8cqi;
		padding: 0.2cqi 0.8cqi;
		border-radius: 999px;
		background: var(--color-bg);
		font-family: var(--font-mono);
		font-size: 1.8cqi;
		color: var(--color-accent-text);
		opacity: 0;
		transition: opacity 0.4s ease;
	}

	.scene-herostory[data-step='7'] .story-agentlet-layer-label {
		opacity: 1;
		transition-delay: 0.2s;
	}

	/* Actions: offered one by one as the panel opens (step 3), then stay.
	   Briefly highlight whichever action was just clicked. */
	.scene-herostory .story-action {
		position: relative;
		padding: 1.4cqi 1.8cqi;
		opacity: 0;
		transform: translateY(1cqi);
		transition:
			opacity 0.3s ease,
			transform 0.3s ease,
			background 0.3s ease,
			border-color 0.3s ease,
			color 0.3s ease;
	}

	.scene-herostory:not([data-step='1'], [data-step='2']) .story-action {
		opacity: 1;
		transform: translateY(0);
	}

	.scene-herostory[data-step='3'] .story-action-receipt {
		transition-delay: 0.6s;
	}

	.scene-herostory[data-step='3'] .story-action-export {
		transition-delay: 1s;
	}

	.scene-herostory[data-step='3'] .story-action-ai {
		transition-delay: 1.4s;
	}

	.scene-herostory[data-step='4'] .story-action-receipt,
	.scene-herostory[data-step='5'] .story-action-export,
	.scene-herostory[data-step='6'] .story-action-ai {
		background: var(--color-primary-bg);
		border-color: var(--color-primary-bg);
		color: var(--color-primary-text);
		transition-delay: 0.7s;
	}

	/* --- Step 4: the upload dialog. It opens after the click, receives
	   the file, shows reading progress, then closes before the form
	   fills. Step 4 dwell is 7000ms: these keyframe durations match. --- */
	.scene-herostory .story-modal-backdrop {
		position: absolute;
		inset: 0;
		z-index: 10;
		display: grid;
		place-items: center;
		background: rgb(0 0 0 / 0.25);
		opacity: 0;
		pointer-events: none;
	}

	.scene-herostory[data-step='4'] .story-modal-backdrop {
		animation: story-modal-backdrop 7000ms ease forwards;
	}

	@keyframes story-modal-backdrop {
		0%,
		12%,
		57%,
		100% {
			opacity: 0;
		}
		16%,
		53% {
			opacity: 1;
		}
	}

	.scene-herostory .story-modal {
		display: flex;
		flex-direction: column;
		gap: 1.6cqi;
		width: 46cqi;
		padding: 2.6cqi;
		border-radius: 8px;
		background: var(--color-bg);
		border: 1px solid var(--color-surface-border);
		box-shadow: 0 1.2cqi 4cqi rgb(0 0 0 / 0.2);
	}

	.scene-herostory[data-step='4'] .story-modal {
		animation: story-modal-pop 7000ms ease forwards;
	}

	@keyframes story-modal-pop {
		0%,
		12% {
			transform: scale(0.94);
		}
		16%,
		100% {
			transform: scale(1);
		}
	}

	.scene-herostory .story-modal-title {
		margin: 0;
		font-size: 2.6cqi;
		font-weight: 600;
		color: var(--color-heading);
	}

	.scene-herostory .story-dropzone {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.6cqi;
		padding: 2.6cqi;
		border: 1.5px dashed var(--color-surface-border);
		border-radius: 6px;
		font-size: 2.2cqi;
		color: var(--color-text);
	}

	.scene-herostory[data-step='4'] .story-dropzone {
		animation: story-dropzone 7000ms ease forwards;
	}

	@keyframes story-dropzone {
		0%,
		18%,
		28%,
		100% {
			border-color: var(--color-surface-border);
		}
		22% {
			border-color: var(--color-accent);
		}
	}

	.scene-herostory .story-dropzone-hint {
		font-size: 1.9cqi;
		color: var(--color-text-muted);
	}

	.scene-herostory .story-file {
