---
// Shared frame for animated product scenes. Purely decorative: the whole
// animated subtree is aria-hidden. The caption is the real accessible
// description, rendered as a sibling (not inside the hidden root); by
// default it is visually hidden (sr-only), since the hero carousel and
// the capability explorer already show the same information as visible
// tab/panel text. Pass captionVisible for a scene shown on its own with
// no surrounding text (the three deployment mode cards).
//
// The fake cursor is NOT positioned here: each scene places <span
// class="scene-cursor"> and <span class="scene-click-pulse"> as children
// of whichever element it clicks (marked .scene-click-target), animating
// from an offset transform to translate(0, 0). That element is the
// cursor's positioning anchor, so it can never drift from its target
// regardless of scene scale. See scenes.css.
interface Props {
	/** Sentence describing what the scene shows; the accessible description. */
	caption: string;
	/** Show the caption as visible text under the scene (deploy mode cards). */
	captionVisible?: boolean;
	/** Loop length in ms; drives every child animation via --scene-duration. */
	duration?: number;
	/** Show the top browser-chrome bar (deploy scenes). */
	chrome?: boolean;
	/** Panel starts hidden and slides in during the timeline. */
	panelHidden?: boolean;
	/** Extra class on the scene root, for a scene's own unique keyframes. */
	class?: string;
	/** CSS aspect-ratio value; defaults to the shared 16 / 10 (see scenes.css). */
	aspectRatio?: string;
}

const {
	caption,
	captionVisible = false,
	duration = 8000,
	chrome = false,
	panelHidden = false,
	class: className,
	aspectRatio,
} = Astro.props;

const style = [`--scene-duration:${duration}ms`, aspectRatio && `aspect-ratio:${aspectRatio}`]
	.filter(Boolean)
	.join(';');
---

<div class="scene-wrap">
	<div class:list={['scene', className]} style={style} aria-hidden="true">
		{
			chrome && (
				<div class="scene-chrome">
					<slot name="chrome" />
				</div>
			)
		}
		<div class="scene-body">
			<div class="scene-app">
				<slot name="app" />
			</div>
			<div class:list={['scene-panel', { 'scene-panel--hidden': panelHidden }]}>
				<slot name="panel" />
			</div>
		</div>
	</div>
	<p class:list={['scene-caption', { 'scene-caption--visible': captionVisible }]}>{caption}</p>
</div>
