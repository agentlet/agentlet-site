---
import SceneFrame from './SceneFrame.astro';

const bars = [40, 65, 50, 82, 58];
---

<SceneFrame
	class="scene-captureai"
	caption="A bar chart being selected with a dashed rectangle, then a thumbnail of it slides into the panel and an answer types out: March is 18 percent above plan, travel drives most of the gap."
>
	<Fragment slot="app">
		<div class="scene-app-url">dashboard.app</div>
		<div class="scene-chart">
			{bars.map((h) => <div class="scene-chart-bar" style={`height:${h}%`} />)}
			<div class="scene-selection"></div>
		</div>
	</Fragment>
	<Fragment slot="panel">
		<div class="scene-panel-brand">
			<img src="/brand/agentlet-symbol-light.svg" alt="" width="16" height="16" />
			<span>agentlet</span>
		</div>
		<div
			class="scene-action scene-action-primary scene-click-target"
			style="--cursor-offset-x:14cqi;--cursor-offset-y:12cqi"
		>
			Ask about the screen
			<span class="scene-cursor"></span>
			<span class="scene-click-pulse"></span>
		</div>
		<div class="scene-thumbnail" style="animation-delay:400ms"></div>
		<p class="scene-answer-line" style="animation-delay:900ms">March is 18% above plan.</p>
		<p class="scene-answer-line" style="animation-delay:1400ms">Travel drives most of the gap.</p>
	</Fragment>
</SceneFrame>

<style is:global>
	.scene-captureai .scene-chart {
		position: relative;
		flex: 1;
		min-height: 30cqi;
		display: flex;
		align-items: flex-end;
		gap: 2cqi;
		padding: 2cqi;
		border: 1px solid var(--color-surface-border);
		border-radius: 6px;
		background: var(--color-surface);
	}

	.scene-captureai .scene-chart-bar {
		flex: 1;
		background: var(--color-surface-border);
		border-radius: 3px 3px 0 0;
	}

	/* A dashed rectangle scaling up from the chart's center to cover it,
	   right as the click lands, then fading as attention moves to the
	   panel. */
	.scene-captureai .scene-selection {
		position: absolute;
		inset: 10%;
		border: 1.5px dashed var(--color-accent);
		border-radius: 4px;
		opacity: 0;
		transform: scale(0.4);
		transform-origin: center;
		animation-name: scene-select-chart;
		animation-timing-function: steps(1, end);
		animation-duration: var(--scene-duration);
		animation-iteration-count: infinite;
	}

	@keyframes scene-select-chart {
		0%,
		27% {
			opacity: 0;
			transform: scale(0.4);
		}
		32%,
		42% {
			opacity: 1;
			transform: scale(1);
		}
		48%,
		100% {
			opacity: 0;
			transform: scale(1);
		}
	}

	/* Smaller than the shared .scene-chip/.scene-thumbnail pattern used
	   elsewhere: this panel already holds an action row and two lines of
	   answer text, so it stays compact to fit both hero and explorer
	   sizes without overflowing the frame. */
	.scene-captureai .scene-thumbnail {
		width: 7cqi;
		height: 4.5cqi;
		border-radius: 4px;
		background: var(--color-surface-border);
		opacity: 0;
		transform: translateY(3cqi);
		animation-name: scene-slide-up;
		animation-timing-function: steps(1, end);
		animation-duration: var(--scene-duration);
		animation-iteration-count: infinite;
	}

	.scene-captureai .scene-answer-line {
		margin: 0;
		font-size: 2.1cqi;
		line-height: 1.3;
		color: var(--color-text);
		clip-path: inset(0 100% 0 0);
		animation-name: scene-reveal;
		animation-timing-function: steps(1, end);
		animation-duration: var(--scene-duration);
		animation-iteration-count: infinite;
	}

</style>
