---
import ThemeToggle from './ThemeToggle.astro';
import AnimationsToggle from './AnimationsToggle.astro';
---

<header class="site-header">
	<div class="wrap">
		<a class="brand" href="/">
			<img class="brand-logo-light" src="/brand/agentlet-lockup-light.svg" width="128" height="32" alt="agentlet" />
			<img class="brand-logo-dark" src="/brand/agentlet-lockup-dark.svg" width="128" height="32" alt="agentlet" />
		</a>
		<nav class="primary-nav" aria-label="Primary">
			<div class="primary-nav-links">
				<a href="/docs/">Docs</a>
				<a href="https://github.com/agentlet/agentlet-core">GitHub</a>
			</div>
			<AnimationsToggle />
			<ThemeToggle />
			<a class="button button-primary button-sm" href="/docs/getting-started/quick-start/">Get started</a>
		</nav>
	</div>
</header>
