---
/**
 * The sandbox the expense-receipt agentlet (src/agentlets/expense-receipt.ts)
 * operates on: a fictitious receipt and a small expense report form, both
 * usable by hand with no agentlet at all. Home page only, right after the
 * hero, so the agentlet's own module pattern (home page only) has a fixed
 * page to target.
 *
 * A native <details>/<summary>, collapsed by default (no `open` attribute,
 * so the collapsed state is the server-rendered one: no layout shift while
 * the page loads), styled as its own clearly separate zone (dashed accent
 * border, tinted background, "Demo sandbox" label) so it never reads as
 * part of the marketing page around it. src/agentlets/shared.ts's
 * openSandbox() opens it and scrolls it into view for the expense-receipt
 * and page-audit demos, both of which operate on it; see that function's
 * own doc comment for why the page audit in particular depends on it being
 * open, not merely present in the DOM.
 *
 * The receipt and its preview image are generated by
 * scripts/generate-demo-receipt.mjs and committed under public/demo/; see
 * that script for the receipt's exact values, which the agentlet's recorded
 * AI response must stay in sync with.
 *
 * Carries three deliberate, discreet accessibility defects for a later
 * "page audit" demo agentlet to find, each marked with a stable
 * data-demo-defect attribute. See the inline comments next to each one for
 * why an automated Lighthouse/axe pass does not flag them.
 */

const RECEIPT_PDF_URL = '/demo/receipt.pdf';
const RECEIPT_PREVIEW_URL = '/demo/receipt-preview.png';
// Scaled down from the generated PNG's native 720x940 (2x of the 360x470
// CSS-pixel page rendered by scripts/generate-demo-receipt.mjs), same
// aspect ratio, fixed so the image never causes layout shift.
const PREVIEW_WIDTH = 216;
const PREVIEW_HEIGHT = 282;

const CURRENCIES = ['EUR', 'GBP', 'USD'];

const CATEGORIES = [
	{ value: 'meals', label: 'Meals and entertainment' },
	{ value: 'travel', label: 'Travel' },
	{ value: 'lodging', label: 'Lodging' },
	{ value: 'supplies', label: 'Office supplies' },
	{ value: 'other', label: 'Other' },
];

// Unrelated to the receipt above: just enough sample history to make the
// sandbox look like a real expense report screen.
const RECENT_EXPENSES: Array<[string, string]> = [
	['2026-02-02', '54.10 EUR'],
	['2026-02-18', '120.00 EUR'],
	['2026-03-01', '18.50 EUR'],
];
---

<section class="sandbox-zone">
	<div class="wrap">
		<details class="sandbox-details" id="sandbox">
			<summary class="sandbox-summary">
				<span class="sandbox-label">Demo sandbox</span>: a sample receipt and an expense form
			</summary>
			<div class="sandbox-body">
				<!--
					Visually hidden: the summary above already shows "Demo
					sandbox" to every visitor, sighted or not, so this heading
					is not repeated on screen. It exists to keep the page's
					heading hierarchy intact (h1 in the hero, h3 further down
					for "Recent expenses"), which a screen reader's heading
					navigation relies on regardless of what is visible.
				-->
				<h2 class="sandbox-heading">Demo sandbox</h2>
				<p class="section-intro">
					A fictitious receipt and a small expense form, usable by hand, that send nothing. Open
					the live demo above and pick "Receipt to expense report" to watch an agentlet read the
					receipt and fill the form for you instead.
				</p>

				<div class="sandbox-grid">
					<figure class="sandbox-receipt">
						<img
							src={RECEIPT_PREVIEW_URL}
							width={PREVIEW_WIDTH}
							height={PREVIEW_HEIGHT}
							class="sandbox-receipt-image"
							data-demo-defect="image-alt"
							alt="receipt-preview.png"
						/>
						<figcaption>
							<a
								class="text-link"
								href={RECEIPT_PDF_URL}
								target="_blank"
								rel="noopener noreferrer">Open the receipt PDF</a
							>
						</figcaption>
					</figure>

					<form class="sandbox-form" id="expense-form" data-expense-form novalidate>
						<div class="form-row">
							<label for="expense-vendor">Vendor</label>
							<input type="text" id="expense-vendor" name="vendor" autocomplete="off" />
						</div>
						<div class="form-row">
							<label for="expense-date">Date</label>
							<input type="date" id="expense-date" name="date" />
						</div>
						<div class="form-row">
							<label for="expense-amount">Amount</label>
							<input type="number" id="expense-amount" name="amount" step="0.01" min="0" />
						</div>
						<div class="form-row">
							<label for="expense-vat">VAT amount</label>
							<input type="number" id="expense-vat" name="vatAmount" step="0.01" min="0" />
						</div>
						<div class="form-row">
							<label for="expense-currency">Currency</label>
							<select id="expense-currency" name="currency">
								{CURRENCIES.map((code) => <option value={code}>{code}</option>)}
							</select>
						</div>
						<div class="form-row">
							<label for="expense-category">Category</label>
							<select id="expense-category" name="category">
								<option value="" selected disabled>Select a category</option>
								{CATEGORIES.map((category) => <option value={category.value}>{category.label}</option>)}
							</select>
						</div>
						<div class="form-row">
							<!--
								Deliberate accessibility defect (data-demo-defect="input-label"):
								this optional field has a placeholder but no <label>, no
								aria-label, and no aria-labelledby. The accessible-name
								algorithm falls back to a non-empty placeholder, so axe's
								label check passes; a screen reader still announces a name,
								but it disappears the moment the field holds a value, which
								is why this is still a real defect. Everything else in this
								sandbox has a proper label.
							-->
							<input
								type="text"
								id="expense-notes"
								name="notes"
								placeholder="Notes (optional)"
								data-demo-defect="input-label"
							/>
						</div>
						<button type="submit" class="button button-primary button-sm">Submit</button>
						<p class="form-status" data-form-status role="status" aria-live="polite">&nbsp;</p>
					</form>
				</div>

				<div class="sandbox-recent">
					<h3>Recent expenses</h3>
					<!--
						Deliberate accessibility defect (data-demo-defect="table-headers"):
						two columns, three rows, only <td> cells and no header row at
						all. axe only requires explicit headers on tables of three by
						three or larger, so this small table is not flagged, even
						though it gives a screen reader no column headers to navigate
						by.
					-->
					<table class="sandbox-recent-table" data-demo-defect="table-headers">
						<tbody>
							{
								RECENT_EXPENSES.map(([date, amount]) => (
									<tr>
										<td>{date}</td>
										<td>{amount}</td>
									</tr>
								))
							}
						</tbody>
					</table>
				</div>
			</div>
		</details>
		<p class="sandbox-note">
			The sandbox is a sample page. To see agentlet on real sites such as Wikipedia, use
			<a class="text-link" href="/try/known-sites/">the known-sites bookmarklet</a>. Its demos are
			read-only.
		</p>
	</div>
</section>

<script>
	// No network action: the demo form never submits, by design (see
	// CLAUDE.md). Submitting by hand just reports that nothing was sent, and
	// the agentlet (src/agentlets/expense-receipt.ts) never calls this at
	// all, since it never submits the form either.
	const form = document.getElementById('expense-form');
	const status = document.querySelector('[data-form-status]');

	form?.addEventListener('submit', (event) => {
		event.preventDefault();
		if (status) status.textContent = 'Demo form. Nothing was sent.';
	});
</script>
