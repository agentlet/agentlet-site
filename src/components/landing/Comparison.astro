---
const rows = [
	{
		aspect: 'Installation',
		robot: 'Heavy: desktop and backend',
		bookmarklet: 'Light: bookmarklet',
		extension: 'Light: browser extension',
		native: 'Light: served by host app',
	},
	{
		aspect: 'Autonomy',
		robot: 'Fully autonomous',
		bookmarklet: 'Needs user action',
		extension: 'Semi-autonomous',
		native: 'Semi-autonomous',
	},
	{
		aspect: 'Security, scope of action',
		robot: 'Full access: OS, files, apps',
		bookmarklet: 'Page privileges, browser only',
		extension: 'Extended: extension APIs',
		native: 'Page privileges, inside app',
	},
	{
		aspect: 'Robustness to UI changes',
		robot: 'Fragile',
		bookmarklet: 'Robust with good selectors',
		extension: 'Same as bookmarklet',
		native: 'Very robust: tied to app code',
	},
	{
		aspect: 'Performance',
		robot: 'Often slow',
		bookmarklet: 'Instant',
		extension: 'Instant',
		native: 'Instant',
	},
	{
		aspect: 'Relies on user context',
		robot: 'Yes',
		bookmarklet: 'Yes',
		extension: 'Yes',
		native: 'Yes',
	},
	{
		aspect: 'Interacts with page like a user',
		robot: 'Yes',
		bookmarklet: 'Yes',
		extension: 'Yes',
		native: 'Yes',
	},
	{
		aspect: 'Goes beyond current page',
		robot: 'Yes',
		bookmarklet: 'No: single page app only',
		extension: 'Yes: across browser tabs',
		native: 'No: single app context',
	},
	{
		aspect: 'Goes beyond browser',
		robot: 'Yes: system-wide',
		bookmarklet: 'No',
		extension: 'No',
		native: 'No',
	},
	{
		aspect: 'Interacts with embedded elements',
		robot: 'Limited: surface only',
		bookmarklet: 'Deep: full DOM access',
		extension: 'Deep: same, plus APIs',
		native: 'Deep: full access to app DOM',
	},
];

const userscriptRows = [
	{
		aspect: 'Install for the user',
		userscript: 'A userscript manager, then the script',
		extension: 'The extension',
		agentlet: 'Nothing for a bookmarklet, or nothing if the app embeds it',
	},
	{
		aspect: 'Runs without a click on matching pages',
		userscript: 'Yes',
		extension: 'Yes',
		agentlet: 'Only when embedded or loaded by an extension. A bookmarklet needs a click',
	},
	{
		aspect: 'Pages with a strict Content Security Policy',
		userscript: 'Works',
		extension: 'Works',
		agentlet: 'A CDN bookmarklet is blocked',
	},
	{
		aspect: 'Panel UI, form, table, screenshot and AI helpers',
		userscript: 'Write them yourself',
		extension: 'Write them yourself',
		agentlet: 'Included',
	},
	{
		aspect: 'Module lifecycle and URL matching',
		userscript: 'Match rules in the script header',
		extension: 'Match rules in the manifest',
		agentlet: 'Included, including single page app navigation',
	},
	{
		aspect: 'Cross-origin requests and background work',
		userscript: 'GM_xmlhttpRequest and storage APIs',
		extension: 'Full extension APIs',
		agentlet: 'Same limits as the host page',
	},
];
---

<section class="alt">
	<div class="wrap">
		<h2 class="section-title">Compared to robots</h2>
		<p class="section-intro">
			Agentlets can look like small, local robots, the kind used in RPA (robotic process
			automation). They are not true bots: they depend on the context of the user's active tab and
			enhance, rather than replace, the user's interaction.
		</p>
		<p class="table-scroll-hint">Scroll for more</p>
		<div class="table-scroll">
			<table class="comparison-table">
				<caption>
					Robots compared to the three agentlet deployment modes
				</caption>
				<thead>
					<tr>
						<th scope="col">Aspect</th>
						<th scope="col">Robot</th>
						<th scope="col">Bookmarklet</th>
						<th scope="col">Extension</th>
						<th scope="col">Native</th>
					</tr>
				</thead>
				<tbody>
					{
						rows.map((row) => (
							<tr>
								<th scope="row">{row.aspect}</th>
								<td>{row.robot}</td>
								<td>{row.bookmarklet}</td>
								<td>{row.extension}</td>
								<td>{row.native}</td>
							</tr>
						))
					}
				</tbody>
			</table>
		</div>
		<h3 class="comparison-subtitle">Compared to userscripts and extensions</h3>
		<p class="section-intro">
			Userscripts (Tampermonkey and similar) and hand-written browser extensions also change pages
			you do not own, and are often the simpler choice. Pick a userscript when only you will use the
			script. Pick an extension when you need browser APIs, background work or a store listing.
			Pick agentlet when colleagues should run the tool from a bookmark without installing anything,
			when the host app can load it directly, or when you want one panel, set of helpers and
			lifecycle across all three ways of shipping it.
		</p>
		<p class="table-scroll-hint">Scroll for more</p>
		<div class="table-scroll">
			<table class="comparison-table">
				<caption>
					Userscripts and hand-written extensions compared to agentlet-core
				</caption>
				<thead>
					<tr>
						<th scope="col">Aspect</th>
						<th scope="col">Userscript</th>
						<th scope="col">Hand-written extension</th>
						<th scope="col">agentlet-core</th>
					</tr>
				</thead>
				<tbody>
					{
						userscriptRows.map((row) => (
							<tr>
								<th scope="row">{row.aspect}</th>
								<td>{row.userscript}</td>
								<td>{row.extension}</td>
								<td>{row.agentlet}</td>
							</tr>
						))
					}
				</tbody>
			</table>
		</div>
	</div>
</section>
