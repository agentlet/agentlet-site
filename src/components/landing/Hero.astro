---
import HeroStoryScene from '../scenes/HeroStoryScene.astro';
import { BOOKMARKLET_FALLBACK_ORIGIN, buildBookmarkletHref } from '../../scripts/bookmarklet';

// One 8-step, ~37s story (see HeroStoryScene.astro), driven by
// src/scripts/scenes.ts setting data-step on the scene root. Durations
// here are the single source of truth: the JS controller reads them off
// each progress segment's data-duration, and HeroStoryScene's CSS
// comments call out where a step's dwell (steps 1 and 4) needs to stay
// in sync with its own keyframe durations. Each segment is a button that
// jumps straight to its step, numbered, with its short label as a tooltip.
const steps = [
	{ label: 'Today', subtitle: 'Your app as it is today. Expenses are typed in by hand, field by field.', duration: 4000 },
	{ label: 'Agentlet', subtitle: 'An agentlet was built to add features to this app. Just click the agentlet icon.', duration: 4000 },
	{ label: 'Panel', subtitle: 'The agentlet panel opens on top of the app and offers its services.', duration: 3500 },
	{ label: 'Receipt', subtitle: 'Read a receipt. Upload it and the form is filled for you. You review and submit.', duration: 7000 },
	{ label: 'Excel', subtitle: 'Export to Excel. The app has no such feature. The agentlet adds it.', duration: 4000 },
	{ label: 'Chat', subtitle: 'Ask questions about the data on the page.', duration: 4500 },
	{ label: 'Layers', subtitle: 'The host page did not change. Everything was added on top, with agentlet.', duration: 4000 },
	{
		label: 'Ideas',
		subtitle: 'These are just examples. Build what your team needs, with many features ready to use in the library.',
		duration: 6000,
	},
];

// The headline is one string on purpose: it is also the title and the
// social titles in src/pages/index.astro, kept in sync by hand.
const HEADLINE = 'Augment the web apps you cannot change.';

// One message per audience, in tab order. The first one (Business) is
// the server-rendered default. Every message is in the HTML (the
// inactive ones stacked invisibly in the same grid cell as the active
// one, so the block never changes height); the
// client script src/scripts/hero-audience.ts selects, rotates and
// cross-fades them. Without JavaScript the tabs are hidden and the four
// messages are shown one after the other, each led by its audience name.
const audiences = [
	{
		id: 'business',
		label: 'Business',
		text: 'Add a side panel with Excel export, form filling and AI to the internal apps your team already uses, without waiting for the vendor or a project.',
	},
	{
		id: 'developers',
		label: 'Developers',
		text: 'A small TypeScript framework for page-specific tools: module lifecycle, side panel, forms, tables, screenshots and AI helpers. Ship it as a bookmarklet, an extension or a script tag.',
	},
	{
		id: 'it-security',
		label: 'IT and security',
		text: "Runs inside the page with the user's own session and permissions. No backend change, no telemetry, and nothing leaves the page unless your agentlet sends it.",
	},
	{
		id: 'ai-builders',
		label: 'AI builders',
		text: "Hand a model the page's forms and tables as clean data, then fill the answer back in. Keep your provider key on your server behind a proxy.",
	},
];
---

<section class="hero">
	<div class="wrap">
		<div class="hero-surface">
			<div class="hero-copy">
				<span class="eyebrow">Open source, MIT</span>
				<h1>{HEADLINE}</h1>
				<div class="hero-audience" data-hero-audience>
					<div class="hero-audience-tabs" role="tablist" aria-label="What agentlet offers, by audience">
						{
							audiences.map((audience, i) => (
								<button
									type="button"
									role="tab"
									class="hero-audience-tab"
									id={`hero-audience-tab-${audience.id}`}
									aria-controls="hero-audience-panel"
									aria-selected={i === 0 ? 'true' : 'false'}
									tabindex={i === 0 ? 0 : -1}
									data-audience={audience.id}
								>
									<span class="hero-audience-tab-label">{audience.label}</span>
									<span class="hero-audience-progress" aria-hidden="true" />
								</button>
							))
						}
					</div>
					<div
						class="hero-audience-panel"
						role="tabpanel"
						id="hero-audience-panel"
						aria-labelledby={`hero-audience-tab-${audiences[0].id}`}
						tabindex="0"
					>
						{
							audiences.map((audience, i) => (
								<p class={`hero-audience-message${i === 0 ? ' is-active' : ''}`} data-audience={audience.id}>
									<strong class="hero-audience-message-label">{audience.label}.</strong>
									<span class="hero-audience-message-text">{audience.text}</span>
								</p>
							))
						}
					</div>
					<noscript>
						<style>
							.hero-audience-tabs {
								display: none !important;
							}
							.hero-audience-panel {
								gap: 0.75rem;
							}
							.hero-audience-message {
								grid-area: auto !important;
								opacity: 1 !important;
								visibility: visible !important;
							}
							.hero-audience-message-label {
								display: inline !important;
							}
						</style>
					</noscript>
				</div>
				<div class="hero-actions">
					<a class="button button-primary" href="/docs/getting-started/quick-start/">Get started</a>
					<a class="button button-secondary" href="https://github.com/agentlet/agentlet-core">
						View on GitHub
					</a>
				</div>
				<div class="hero-demo-actions">
					<button type="button" class="button button-secondary hero-demo-button" id="hero-try-button">
						Try it on this page
					</button>
					<div class="hero-bookmarklet">
						<a
							class="hero-bookmarklet-chip"
							id="hero-bookmarklet-chip"
							href={buildBookmarkletHref(BOOKMARKLET_FALLBACK_ORIGIN)}
							aria-label="agentlet demo bookmarklet, drag to your bookmarks bar"
						>
							agentlet demo
						</a>
						<p class="hero-bookmarklet-hint">
							Drag it to your bookmarks bar. <a class="text-link" href="/try/bookmarklet/">How it works</a>
						</p>
					</div>
					<a class="text-link hero-known-sites-link" href="/try/known-sites/">
						Try it on real sites, like Wikipedia
					</a>
					<p class="hero-demo-mobile-hint">Best on desktop</p>
				</div>
			</div>
			<div class="hero-story" data-story>
				<HeroStoryScene />
				<p class="story-subtitle" aria-hidden="true" data-story-subtitle>&nbsp;</p>
				<div class="story-progress">
					{
						steps.map((step, i) => (
							<button
								type="button"
								class="story-segment"
								data-story-segment
								data-duration={step.duration}
								aria-label={`Go to step ${i + 1}: ${step.subtitle}`}
								title={`${i + 1}. ${step.label}`}
							>
								<span class="story-segment-track">
									<span class="story-segment-fill" />
								</span>
								<span class="story-segment-label" aria-hidden="true">
									{i + 1}
								</span>
							</button>
						))
					}
				</div>
				<div class="story-controls">
					<button type="button" class="story-control" data-story-toggle aria-label="Pause animation">
						<svg class="icon-pause" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
							<rect x="6" y="5" width="4" height="14" rx="1"></rect>
							<rect x="14" y="5" width="4" height="14" rx="1"></rect>
						</svg>
						<svg class="icon-play" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
							<path d="M7 5v14l12-7z"></path>
						</svg>
					</button>
					<button type="button" class="story-control story-replay" data-story-replay>Replay</button>
				</div>
				<ol class="story-steps">
					{steps.map((step) => <li>{step.subtitle}</li>)}
				</ol>
			</div>
		</div>
	</div>
</section>

<script>
	import '../../scripts/hero-audience.ts';
</script>

<script>
	// The hero button is the only thing on the home page that can start
	// downloading agentlet-core, and nothing loads until this click, not
	// even the loader script itself. LOADER_URL is the single source of
	// truth for its path (src/scripts/agentlet-inline-snippets.mjs).
	import { LOADER_URL } from '../../scripts/agentlet-inline-snippets.mjs';
	import { BOOKMARKLET_FALLBACK_ORIGIN, buildBookmarkletHref } from '../../scripts/bookmarklet';

	function openDemo(): void {
		(window as unknown as { __openAgentletDemo?: () => void }).__openAgentletDemo?.();
	}

	document.getElementById('hero-try-button')?.addEventListener('click', () => {
		const win = window as unknown as { __openAgentletDemo?: () => void };
		if (win.__openAgentletDemo) {
			openDemo();
			return;
		}
		const script = document.createElement('script');
		script.type = 'module';
		script.src = LOADER_URL;
		script.onload = openDemo;
		document.head.appendChild(script);
	});

	// Same origin rewrite as /try/bookmarklet/ (src/pages/try/bookmarklet.astro):
	// the server-rendered href points at the production origin, rewritten here
	// to the page's own origin so the chip also works from a local dev server
	// or a preview deployment. Clicking the chip directly runs the same
	// javascript: code a browser runs when it is clicked from the bookmarks
	// bar; no extra handler is needed for that.
	const bookmarkletChip = document.getElementById('hero-bookmarklet-chip');
	if (bookmarkletChip) {
		const origin = window.location.origin || BOOKMARKLET_FALLBACK_ORIGIN;
		bookmarkletChip.setAttribute('href', buildBookmarkletHref(origin));
	}
</script>
