---
import HeroStoryScene from '../scenes/HeroStoryScene.astro';

// One 8-step, ~37s story (see HeroStoryScene.astro), driven by
// src/scripts/scenes.ts setting data-step on the scene root. Durations
// here are the single source of truth: the JS controller reads them off
// each progress segment's data-duration, and HeroStoryScene's CSS
// comments call out where a step's dwell (steps 1 and 4) needs to stay
// in sync with its own keyframe durations. Each segment is a button that
// jumps straight to its step, numbered, with its short label as a tooltip.
const steps = [
	{ label: 'Today', subtitle: 'Your app as it is today. Expenses are typed in by hand, field by field.', duration: 4000 },
	{ label: 'Agentlet', subtitle: 'An agentlet was built to add features to this app. Just click the agentlet icon.', duration: 4000 },
	{ label: 'Panel', subtitle: 'The agentlet panel opens on top of the app and offers its services.', duration: 3500 },
	{ label: 'Receipt', subtitle: 'Read a receipt. Upload it and the form is filled for you. You review and submit.', duration: 7000 },
	{ label: 'Excel', subtitle: 'Export to Excel. The app has no such feature. The agentlet adds it.', duration: 4000 },
	{ label: 'Chat', subtitle: 'Ask questions about the data on the page.', duration: 4500 },
	{ label: 'Layers', subtitle: 'The host page did not change. Everything was added on top, with agentlet.', duration: 4000 },
	{
		label: 'Ideas',
		subtitle: 'These are just examples. Build what your team needs, with many features ready to use in the library.',
		duration: 6000,
	},
];
---

<section class="hero">
	<div class="wrap">
		<div class="hero-surface">
			<div class="hero-copy">
				<span class="eyebrow">Open source, MIT</span>
				<h1>Augment your web apps, without touching the backend.</h1>
				<p>
					Drop a small agent into any page with a bookmarklet, an extension, or a native
					integration. It adds a side panel with the actions your team needs.
				</p>
				<div class="hero-actions">
					<a class="button button-primary" href="/docs/getting-started/install/">Get started</a>
					<a class="button button-secondary" href="https://github.com/agentlet/agentlet-core">
						View on GitHub
					</a>
				</div>
				<div class="hero-demo-actions">
					<button type="button" class="button button-secondary hero-demo-button" id="hero-try-button">
						Try it on this page
					</button>
					<p class="hero-demo-mobile-hint">Best on desktop</p>
					<a class="text-link hero-bookmarklet-link" href="/try/bookmarklet/">Or try it on any page</a>
				</div>
			</div>
			<div class="hero-story" data-story>
				<HeroStoryScene />
				<p class="story-subtitle" aria-hidden="true" data-story-subtitle>&nbsp;</p>
				<div class="story-progress">
					{
						steps.map((step, i) => (
							<button
								type="button"
								class="story-segment"
								data-story-segment
								data-duration={step.duration}
								aria-label={`Go to step ${i + 1}: ${step.subtitle}`}
								title={`${i + 1}. ${step.label}`}
							>
								<span class="story-segment-track">
									<span class="story-segment-fill" />
								</span>
								<span class="story-segment-label" aria-hidden="true">
									{i + 1}
								</span>
							</button>
						))
					}
				</div>
				<div class="story-controls">
					<button type="button" class="story-control" data-story-toggle aria-label="Pause animation">
						<svg class="icon-pause" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
							<rect x="6" y="5" width="4" height="14" rx="1"></rect>
							<rect x="14" y="5" width="4" height="14" rx="1"></rect>
						</svg>
						<svg class="icon-play" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
							<path d="M7 5v14l12-7z"></path>
						</svg>
					</button>
					<button type="button" class="story-control story-replay" data-story-replay>Replay</button>
				</div>
				<ol class="story-steps">
					{steps.map((step) => <li>{step.subtitle}</li>)}
				</ol>
			</div>
		</div>
	</div>
</section>

<script>
	// The hero button is the only thing on the home page that can start
	// downloading agentlet-core, and nothing loads until this click, not
	// even the loader script itself. LOADER_URL is the single source of
	// truth for its path (src/scripts/agentlet-inline-snippets.mjs).
	import { LOADER_URL } from '../../scripts/agentlet-inline-snippets.mjs';

	function openDemo(): void {
		(window as unknown as { __openAgentletDemo?: () => void }).__openAgentletDemo?.();
	}

	document.getElementById('hero-try-button')?.addEventListener('click', () => {
		const win = window as unknown as { __openAgentletDemo?: () => void };
		if (win.__openAgentletDemo) {
			openDemo();
			return;
		}
		const script = document.createElement('script');
		script.type = 'module';
		script.src = LOADER_URL;
		script.onload = openDemo;
		document.head.appendChild(script);
	});
</script>
