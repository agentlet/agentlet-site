---
import FillFormScene from '../scenes/FillFormScene.astro';
import ExportTableScene from '../scenes/ExportTableScene.astro';
import CaptureAiScene from '../scenes/CaptureAiScene.astro';
import PdfToFormScene from '../scenes/PdfToFormScene.astro';
import DialogScene from '../scenes/DialogScene.astro';

const slides = [
	{ id: 'hero-slide-0', label: 'Fill a form', Scene: FillFormScene },
	{ id: 'hero-slide-1', label: 'Export a table', Scene: ExportTableScene },
	{ id: 'hero-slide-2', label: 'Ask about the screen', Scene: CaptureAiScene },
	{ id: 'hero-slide-3', label: 'Read a PDF', Scene: PdfToFormScene },
	{ id: 'hero-slide-4', label: 'Ask the user', Scene: DialogScene },
];
---

<section class="hero">
	<div class="wrap">
		<div class="hero-surface">
			<div class="hero-copy">
				<span class="eyebrow">Open source, MIT</span>
				<h1>Augment your web apps, without touching the backend.</h1>
				<p>
					Drop a small agent into any page with a bookmarklet, an extension, or a native
					integration. It adds a side panel with the actions your team needs.
				</p>
				<div class="hero-actions">
					<a class="button button-primary" href="/docs/getting-started/">Get started</a>
					<a class="button button-secondary" href="https://github.com/agentlet/agentlet-core">
						View on GitHub
					</a>
				</div>
				<p class="badge">Live demo, coming soon</p>
			</div>
			<div
				class="hero-scene-carousel"
				data-scene-carousel
				role="region"
				aria-roledescription="carousel"
				aria-label="Feature preview"
			>
				<div class="hero-scene-viewport" aria-live="off">
					{
						slides.map(({ id, Scene }, i) => (
							<div class="hero-scene-slide" id={id} data-slide hidden={i !== 0}>
								<Scene />
							</div>
						))
					}
				</div>
				<div class="hero-carousel-controls">
					<div class="hero-carousel-tabs" role="tablist" aria-label="Choose a feature to preview">
						{
							slides.map((slide, i) => (
								<button
									type="button"
									role="tab"
									id={`hero-tab-${i}`}
									aria-controls={slide.id}
									aria-selected={i === 0 ? 'true' : 'false'}
									tabindex={i === 0 ? 0 : -1}
								>
									<span class="hero-tab-label">{slide.label}</span>
									<span class="hero-progress" aria-hidden="true">
										<span class="hero-progress-fill" />
									</span>
								</button>
							))
						}
					</div>
					<button type="button" class="hero-carousel-toggle" data-carousel-toggle aria-label="Pause animation">
						<svg class="icon-pause" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
							<rect x="6" y="5" width="4" height="14" rx="1"></rect>
							<rect x="14" y="5" width="4" height="14" rx="1"></rect>
						</svg>
						<svg class="icon-play" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
							<path d="M7 5v14l12-7z"></path>
						</svg>
					</button>
				</div>
			</div>
		</div>
	</div>
</section>
