---
// Site-wide "Pause animations" toggle (WCAG 2.2.2). It is a genuine
// toggle button: the accessible name never changes, only aria-pressed
// does, so the pressed state is the only thing announced. Pressing it
// pauses every scene's JS timers and CSS animations (see
// src/scripts/scenes.ts and the html[data-animations="paused"] rule in
// src/styles/scenes.css) and pauses the two demo videos, swapping them
// for a still frame (see src/components/landing/Demo.astro). The choice persists in
// localStorage and is applied before first paint, the same way
// ThemeToggle's theme choice is (see the inline script in
// src/layouts/LandingLayout.astro).
---

<button
	type="button"
	class="theme-toggle animations-toggle"
	id="animations-toggle"
	aria-pressed="false"
	aria-label="Pause animations"
	title="Pause animations"
>
	<svg class="icon-pause" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
		<rect x="6" y="5" width="4" height="14" rx="1"></rect>
		<rect x="14" y="5" width="4" height="14" rx="1"></rect>
	</svg>
	<svg class="icon-play" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
		<path d="M7 5v14l12-7z"></path>
	</svg>
</button>

<script>
	const storageKey = 'agentlet-animations';
	const toggle = document.getElementById('animations-toggle');

	function isPaused(): boolean {
		return document.documentElement.dataset.animations === 'paused';
	}

	function applyState(paused: boolean): void {
		document.documentElement.dataset.animations = paused ? 'paused' : 'playing';
		toggle?.setAttribute('aria-pressed', String(paused));
		document.dispatchEvent(new CustomEvent('agentlet:animations-change', { detail: { paused } }));
	}

	// Sync this button to whatever the inline head script (or a previous
	// page view) already applied, in case it differs from the "playing"
	// default baked into the markup above.
	toggle?.setAttribute('aria-pressed', String(isPaused()));

	toggle?.addEventListener('click', () => {
		const next = !isPaused();
		applyState(next);
		try {
			localStorage.setItem(storageKey, next ? 'paused' : 'playing');
		} catch {
			// localStorage may be unavailable (private browsing, blocked storage).
		}
	});
</script>
