---
const commands = [
	'git clone https://github.com/agentlet/agentlet-core.git',
	'cd agentlet-core',
	'npm install',
	'npm run demo',
];
const commandsRaw = commands.join('\n');
---

<section>
	<div class="wrap">
		<h2 class="section-title">Get started</h2>
		<p class="section-intro">Clone the core library and run the built-in demo.</p>
		<div class="code-block" id="get-started-commands" data-commands={commandsRaw}>
			<div class="code-block-header">
				<span class="code-block-label">terminal</span>
				<button type="button" class="copy-button" id="copy-commands" aria-live="polite">Copy</button>
			</div>
			<pre>{
				commands.map((command) => (
					<div>
						<span class="prompt" aria-hidden="true">
							$
						</span>
						{command}
					</div>
				))
			}</pre>
		</div>
		<p class="get-started-link"><a href="/docs/getting-started/install/">Read the getting started guide</a></p>
	</div>
</section>

<script>
	const container = document.getElementById('get-started-commands');
	const button = document.getElementById('copy-commands');

	button?.addEventListener('click', async () => {
		const text = container?.dataset.commands ?? '';
		try {
			await navigator.clipboard.writeText(text);
			const original = button.textContent;
			button.textContent = 'Copied';
			setTimeout(() => {
				button.textContent = original;
			}, 2000);
		} catch {
			// Clipboard API may be unavailable; the commands remain selectable.
		}
	});
</script>
