---
// Toggles between light and dark using the same localStorage key and
// data-theme attribute convention as Starlight ("starlight-theme",
// <html data-theme="light|dark">), so the choice carries over to /docs/.
---

<button type="button" class="theme-toggle" id="theme-toggle" aria-label="Toggle color theme">
	<svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
		<circle cx="12" cy="12" r="4"></circle>
		<path
			d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"
		></path>
	</svg>
	<svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
		<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z"></path>
	</svg>
</button>

<script>
	const storageKey = 'starlight-theme';
	const toggle = document.getElementById('theme-toggle');

	function currentTheme(): 'light' | 'dark' {
		return document.documentElement.dataset.theme === 'light' ? 'light' : 'dark';
	}

	toggle?.addEventListener('click', () => {
		const next = currentTheme() === 'light' ? 'dark' : 'light';
		document.documentElement.dataset.theme = next;
		try {
			localStorage.setItem(storageKey, next);
		} catch {
			// localStorage may be unavailable (private browsing, blocked storage).
		}
	});
</script>
