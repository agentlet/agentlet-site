---
// Each demo is a looping, muted video (WebM and MP4, public/img/*.webm and
// *.mp4) paired with a still frame at the same dimensions
// (public/img/*-still.png, the video's first frame, also used as its
// poster). The site-wide "Pause animations" toggle pauses the videos and
// swaps to the still (see the script below, src/styles/landing.css and
// AnimationsToggle.astro). While paused, a play control over the still
// (.demo-play) says so and resumes animations site-wide through the same
// state and event as the header toggle (src/scripts/animations.ts).
const demos = [
	{
		video: '/img/demo-part1',
		still: '/img/demo-part1-still.png',
		alt: 'An expense reviewer opening a hotel receipt, scrolling through it to check the total and dates, then ticking the checklist and approving the claim by hand',
		caption: 'Manual processing of a recurring task',
	},
	{
		video: '/img/demo-part2',
		still: '/img/demo-part2-still.png',
		alt: 'The same expense app with an agentlet side panel that reads every receipt with AI, flags the one that does not match and pre-checks the others for the reviewer to approve',
		caption: 'The same application, augmented with an agentlet (AI answers replayed for the recording)',
	},
];
---

<section class="alt" id="demo">
	<div class="wrap">
		<h2 class="section-title">See it in action</h2>
		<p class="section-intro">
			The same business application, before and after being augmented with an agentlet.
		</p>
		<div class="demo-list">
			{
				demos.map((demo) => (
					<figure class="demo-figure">
						<div class="demo-media">
							<video
								class="demo-media-video"
								autoplay
								loop
								muted
								playsinline
								tabindex="-1"
								preload="metadata"
								poster={demo.still}
								width="1280"
								height="720"
								aria-label={demo.alt}
							>
								<source src={`${demo.video}.webm`} type="video/webm" />
								<source src={`${demo.video}.mp4`} type="video/mp4" />
							</video>
							<img
								class="demo-media-still"
								src={demo.still}
								width="1280"
								height="720"
								loading="lazy"
								decoding="async"
								alt={demo.alt}
							/>
							<button type="button" class="demo-play">
								<span class="demo-play-icon" aria-hidden="true">
									<svg viewBox="0 0 24 24">
										<path d="M7 5v14l12-7z" />
									</svg>
								</span>
								<span class="demo-play-label">Animations paused, play</span>
							</button>
						</div>
						<figcaption>{demo.caption}</figcaption>
					</figure>
				))
			}
		</div>
	</div>
</section>

<script>
	// Keep the videos in step with the animations state: the head script in
	// LandingLayout.astro sets html[data-animations] before first paint, and
	// src/scripts/animations.ts dispatches this event on every change, from
	// the header toggle or the play control below. While paused the video is
	// also hidden by CSS, which shows the still frame in its place.
	import {
		ANIMATIONS_CHANGE_EVENT,
		isAnimationsPaused,
		setAnimationsPaused,
	} from '../../scripts/animations.ts';

	const videos = document.querySelectorAll<HTMLVideoElement>('.demo-media-video');

	function syncVideos(): void {
		const paused = isAnimationsPaused();
		for (const video of videos) {
			if (paused) {
				video.pause();
			} else {
				// play() rejects if the browser blocks autoplay; the poster stays visible then.
				video.play().catch(() => {});
			}
		}
	}

	syncVideos();
	document.addEventListener(ANIMATIONS_CHANGE_EVENT, syncVideos);

	for (const button of document.querySelectorAll<HTMLButtonElement>('.demo-play')) {
		button.addEventListener('click', () => {
			setAnimationsPaused(false);
			// The button disappears as animations resume; move focus to the
			// video beside it so keyboard and screen reader users keep their place.
			button.parentElement?.querySelector<HTMLVideoElement>('.demo-media-video')?.focus({ preventScroll: true });
		});
	}
</script>
