{
  "name": "agentlet-site",
  "version": "0.1.0",
  "private": true,
  "description": "Source of agentlet.io: presentation site and documentation for the agentlet framework",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "predev": "node scripts/build-cdn.mjs && node scripts/build-known-sites.mjs",
    "dev": "astro dev",
    "prebuild": "node scripts/build-cdn.mjs",
    "build": "astro build",
    "build:cdn": "node scripts/build-cdn.mjs",
    "build:known-sites": "node scripts/build-known-sites.mjs",
    "generate:demo-receipt": "node scripts/generate-demo-receipt.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint . && node scripts/check-typography.mjs src public astro.config.mjs packages scripts tests .github",
    "pretest:e2e": "node scripts/build-known-sites.mjs",
    "test:e2e": "playwright test",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.42.3",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "agentlet-core": "^2.3.0",
    "astro": "^7.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "starlight-links-validator": "^0.26.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@playwright/test": "1.55.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "eslint-plugin-astro": "^3.2.1",
    "husky": "^9.1.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "wrangler": "^4.42.4",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
